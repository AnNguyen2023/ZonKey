{
  "name": "zonkey-vscode-spike",
  "publisher": "zonkey-spike",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AnNguyen2023/ZonKey.git"
  },
  "description": "ZonKey query/reject-only VS Code host surface for Windows 11 x64",
  "type": "module",
  "engines": {
    "node": ">=22",
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "zonkey": {
    "endpointProtocol": "zonkey.host-transport/1",
    "stateFormat": "recovery-state v2"
  },
  "contributes": {
    "commands": [
      {
        "command": "zonkeySpike.probe",
        "title": "Zonkey spike: probe cooperating-host apply"
      },
      {
        "command": "zonkeySpike.endpointStatus",
        "title": "Zonkey spike: endpoint status"
      },
      {
        "command": "zonkeySpike.endpointConnect",
        "title": "Zonkey spike: connect to discovered endpoint"
      },
      {
        "command": "zonkeySpike.checkCurrentHandoff",
        "title": "Zonkey spike: check current handoff"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.cjs",
    "compile:test": "esbuild integration/real-vscode.entry.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/real-vscode-validation.cjs",
    "compile:transport": "esbuild integration/real-vscode-transport.entry.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/transport-validation.cjs",
    "compile:handoff": "esbuild integration/real-vscode-handoff.entry.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/handoff-validation.cjs",
    "compile:handoff-live": "esbuild integration/real-vscode-handoff-live.entry.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/handoff-live-validation.cjs",
    "compile:m3d37": "esbuild integration/real-vscode-m3d37.entry.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/m3d37-physical-smoke.cjs",
    "compile:recovery": "esbuild integration/real-vscode-recovery.entry.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/recovery-validation.cjs",
    "test:real": "npm run compile && npm run compile:test && node scripts/run-real-vscode.mjs",
    "test:transport": "npm run compile:transport && node scripts/run-transport-integration.mjs",
    "test:handoff": "npm run compile:handoff && node scripts/run-handoff-integration.mjs",
    "test:recovery": "npm run compile:recovery && node scripts/run-recovery-integration.mjs",
    "probe:handoff-live": "node scripts/handoff-live-probe.mjs",
    "smoke:m3d23": "npm run compile:handoff-live && node scripts/run-m3d23-smoke.mjs",
    "smoke:m3d23-tooling": "npm run compile:handoff-live && node scripts/run-m3d23-smoke.mjs --scripted-tooling-check",
    "smoke:m3d37": "npm run package && npm run compile:m3d37 && node scripts/run-m3d37-smoke.mjs",
    "test:handoff-live": "npm run compile:handoff-live && node scripts/run-handoff-live-integration.mjs",
    "compile:prod": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.cjs",
    "package": "npm run compile:prod && npx --yes @vscode/vsce package --no-dependencies && npm run check:vsix",
    "check:vsix": "node scripts/check-vsix.mjs",
    "beta:package": "npm run package && node ../../scripts/package-beta.mjs",
    "test:endpoint": "npm run compile:endpoint && node scripts/run-clean-profile.mjs",
    "compile:endpoint": "esbuild integration/real-vscode-endpoint.entry.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/endpoint-profile-validation.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
